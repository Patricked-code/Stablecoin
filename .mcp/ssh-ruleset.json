{
  "schemaVersion": 1,
  "name": "Stablecoin Governed SSH Ruleset",
  "mode": "READ_ONLY_FIRST",
  "rules": {
    "canonicalRepository": "Patricked-code/Stablecoin",
    "canonicalBranch": "main",
    "allowRawRemoteCommands": false,
    "allowRootLogin": false,
    "allowSudo": false,
    "strictHostKeyChecking": true,
    "pinnedKnownHostsRequired": true,
    "printSecrets": false,
    "readEnvironmentFiles": false,
    "runtimeMutationBeforeFreshVerification": false,
    "branchSwitch": false,
    "forcePush": false,
    "historyRewrite": false,
    "destructiveSync": false,
    "gitResetHard": false,
    "gitClean": false,
    "gitPull": false,
    "gitFetchOnServer": false,
    "serviceRestart": false,
    "deployment": false
  },
  "allowlistedActions": [
    "inventory",
    "git_state",
    "runtime_processes",
    "full_readonly"
  ],
  "forbiddenRemotePatterns": [
    "rm -rf",
    "git reset --hard",
    "git clean",
    "git checkout",
    "git switch",
    "git pull",
    "git fetch",
    "git push",
    "sudo",
    "systemctl restart",
    "service restart",
    "touch tmp/restart.txt"
  ],
  "activationGateForMutationActions": {
    "status": "CLOSED",
    "openOnlyAfter": [
      "LIVE_SERVER_RECONCILIATION_COMPLETE",
      "SERVER_REPOSITORY_ATTESTED",
      "SERVER_BRANCH_ATTESTED",
      "SERVER_HEAD_ATTESTED",
      "WORKTREE_ATTESTED",
      "RUNTIME_ATTESTED",
      "SAFE_RECONCILIATION_PLAN_PERSISTED"
    ]
  }
}

{
  "schemaVersion": 1,
  "repository": "Patricked-code/Stablecoin",
  "project": "Stablecoin",
  "role": "application_repository",
  "defaultBranch": "main",
  "governance": {
    "persistentMemory": true,
    "zeroRegression": true,
    "loopEngineering": true,
    "sourceOfTruth": "SOURCE_OF_TRUTH.md",
    "machineValidated": true,
    "governanceValidator": "scripts/verify-governance-consistency.js",
    "governanceCI": ".github/workflows/governance-consistency.yml"
  },
  "requiredFiles": [
    "GOVERNANCE.md",
    "SOURCE_OF_TRUTH.md",
    "AGENTS.md",
    "SUIVI.md",
    "TODO.md",
    "DECISIONS.md",
    "ARCHITECTURE.md",
    "LOOP_ENGINEERING.md",
    "docs/STABLECOIN_PLESK_DEPLOYMENT_RUNBOOK.md",
    "scripts/verify-governance-consistency.js",
    ".github/workflows/governance-consistency.yml"
  ],
  "memoryRoles": {
    "governance": "GOVERNANCE.md",
    "sourceOfTruth": "SOURCE_OF_TRUTH.md",
    "agentRules": "AGENTS.md",
    "currentStateAndHistory": "SUIVI.md",
    "backlog": "TODO.md",
    "decisions": "DECISIONS.md",
    "architecture": "ARCHITECTURE.md",
    "loopEngineering": "LOOP_ENGINEERING.md",
    "deploymentRunbook": "docs/STABLECOIN_PLESK_DEPLOYMENT_RUNBOOK.md",
    "currentTaskCheckpointEvidence": "SUIVI.md#current-state-block"
  },
  "historicalEvidence": {
    "branch": "codex/wealthtech-mcp-conversation-memory",
    "classification": "HISTORICAL_EVIDENCE_NOT_CURRENT_AUTHORITY"
  },
  "runtime": {
    "documented": true,
    "managed": true,
    "verificationStatus": "DOCUMENTED_UNVERIFIED",
    "requiresFreshVerificationBeforeMutation": true
  },
  "mcpIntegration": {
    "mode": "repository_adapter",
    "coreModificationRequired": false,
    "registrationStatus": "NOT_ATTESTED_BY_LIVE_MCP_IN_THIS_CHANGE",
    "existingExternalSshBridgePolicy": "REUSE_AND_REVALIDATE_EXISTING_WEALTHTECH_SSH_BRIDGE_NO_PARALLEL_TRANSPORT",
    "fallbackSshTransport": {
      "decision": "DEC-2026-09-26-016",
      "alignmentDecision": "DEC-2026-09-26-017",
      "model": "WEALTHTECHINNOVATIONS_API_OPCV_GITHUB_ACTIONS_S2_SSH",
      "primaryChannel": "wealthtech_ssh_bridge",
      "fallbackChannel": ".github/workflows/governed-ssh-readonly.yml",
      "workflows": {
        "readonlyActions": ".github/workflows/governed-ssh-readonly.yml",
        "observe": ".github/workflows/stablecoin-s2-observe.yml",
        "reconcile": ".github/workflows/stablecoin-s2-reconcile.yml",
        "secretInventory": ".github/workflows/stablecoin-s2-secret-inventory.yml",
        "hostKeyVerify": ".github/workflows/stablecoin-s2-hostkey-verify.yml"
      },
      "scriptsRoot": ".github/scripts/s2",
      "script": ".github/scripts/s2/governed-readonly.sh",
      "guard": ".github/scripts/s2/s2_git_guard.sh",
      "hostKeyPin": ".github/scripts/s2/s2_known_hosts.tofu",
      "trigger": "workflow_dispatch_only",
      "allowedOnlyWhen": "PRIMARY_MCP_CHANNEL_UNAVAILABLE_WITH_RECORDED_REASON",
      "mode": "READ_ONLY_ALLOWLISTED_ACTIONS_PLUS_BOUNDED_FRONTEND_FAST_FORWARD",
      "writeAllowed": "BOUNDED_FRONTEND_EXACT_SHA_FAST_FORWARD_ZERO_APPLICATION_DIFF_WITH_CONFIRMATION_ONLY",
      "genericShellAllowed": false,
      "buildOrRestartAllowed": false,
      "sshUser": "S2_USER_OR_ROOT_DEFAULT_SAME_AS_MCP_AND_AFRICAFUNDS",
      "requiredSecrets": ["S2_HOST", "S2_SSH_KEY"],
      "optionalSecrets": ["S2_USER", "S2_KNOWN_HOSTS", "S2_REPORT_PASSPHRASE"],
      "legacySecretAliases": {
        "STABLECOIN_SSH_HOST": "S2_HOST",
        "STABLECOIN_SSH_PRIVATE_KEY": "S2_SSH_KEY",
        "STABLECOIN_SSH_KNOWN_HOSTS": "S2_KNOWN_HOSTS",
        "STABLECOIN_SSH_USER": "S2_USER"
      },
      "mcpClassifierCompatibility": "ALL_FALLBACK_FILES_UNDER_.github_SO_THE_MCP_BOUNDED_FAST_FORWARD_KEEPS_THEM_NON_APPLICATION",
      "secretsStatus": "NOT_CONFIGURED_AT_2026-09-26"
    }
  }
}
